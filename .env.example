# === Database Configuration ===
# For SQLite local development: leave DATABASE_URL commented out
# For Supabase PostgreSQL: uncomment and fill in your connection string
# DATABASE_URL="postgresql://username:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# === Security & Env ===
SECRET_KEY="your-super-secret-key-here"
FLASK_DEBUG="False"
SESSION_COOKIE_SECURE="False"  # Set to True if deploying on HTTPS (production)

# === Google OAuth Credentials (Optional) ===
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# === Email Notification (Gmail SMTP) ===
MAIL_USERNAME="your_email@gmail.com"
MAIL_PASSWORD="your_gmail_app_password_here"
MAIL_DEFAULT_SENDER="your_email@gmail.com"
